# Copy to .env and fill in values before running locally
# Never commit .env to git

NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dco_cms
DB_USER=dco
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Session
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-app-hostname.example.mil
