# Iron Bank is the DoD trusted base image source (registry1.dso.mil).
# LOCAL TESTING: override with Docker Hub via --build-arg (see docker-compose.yml)
# CDSO PIPELINE:  leave ARG at default — Iron Bank image is used automatically

ARG NGINX_IMAGE=registry1.dso.mil/ironbank/opensource/nginx/nginx:1.25

FROM ${NGINX_IMAGE}

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY nginx/nginx.conf /etc/nginx/conf.d/app.conf

# Copy static frontend files
COPY index.html landing.html dashboard.html renewal.html \
     budget.html priorities.html audit-log.html email-demo.html \
     /usr/share/nginx/html/

COPY css/  /usr/share/nginx/html/css/
COPY js/   /usr/share/nginx/html/js/
COPY data/ /usr/share/nginx/html/data/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1
